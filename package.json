{
  "name": "yubai-dramaflow",
  "version": "1.0.1",
  "description": "YubAI DramaFlow - AI漫剧生成客户端",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --x64"
  },
  "keywords": [
    "electron",
    "ai",
    "drama"
  ],
  "author": "YubAI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-log": "^5.3.4",
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "com.yubai.dramaflow",
    "productName": "YubAI DramaFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "http://39.107.251.193:8000/api/client/version"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  }
}